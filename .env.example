# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra Gemini keys, comma-separated. Tried in order when a key fails or runs out of quota.
# GEMINI_API_KEYS=key2,key3
# Optional. Defaults to gemini-flash-latest.
# GEMINI_MODEL=

# Backup, used when Gemini fails or has no key. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional extra Groq keys, comma-separated.
# GROQ_API_KEYS=key2,key3
# Optional. Defaults to openai/gpt-oss-20b.
# GROQ_MODEL=
